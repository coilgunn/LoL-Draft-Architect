# ==========================================================
# Configuration optionnelle (Mode Collaboratif & Pont LCU)
# Copiez ce fichier en .env (en local) ou ajoutez ces clés
# dans Vercel > Project Settings > Environment Variables.
# ==========================================================

# Supabase Realtime (pour la synchro Coach + 5 Joueurs sur Vercel)
PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
PUBLIC_SUPABASE_ANON_KEY=votre-cle-publique-anon

# Port local du compagnon LCU (Client League of Legends)
LCU_BRIDGE_PORT=4242
